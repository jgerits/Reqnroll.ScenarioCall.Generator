<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup>
    <!-- Register the generator plugin for Reqnroll code generation -->
    <ReqnrollGeneratorPlugins Include="$(MSBuildThisFileDirectory)..\lib\netstandard2.0\Reqnroll.ScenarioCall.Generator.dll" />
  </ItemGroup>

  <Target Name="CopyScenarioCallRuntimePlugin" AfterTargets="CopyFilesToOutputDirectory">
    <Copy
      SourceFiles="$(TargetDir)Reqnroll.ScenarioCall.Generator.dll"
      DestinationFiles="$(TargetDir)Reqnroll.ScenarioCall.Generator.ReqnrollPlugin.dll"
      SkipUnchangedFiles="true"
      Condition="Exists('$(TargetDir)Reqnroll.ScenarioCall.Generator.dll')" />
  </Target>
</Project>
